@model IEnumerable<GLMS.Web.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Service Requests</h2>
        <small class="text-muted">All service requests across contracts</small>
    </div>
    <a asp-action="Create" class="btn btn-dark">+ New Service Request</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <strong>Done!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">#</th>
                    <th>Contract</th>
                    <th>Client</th>
                    <th>Description</th>
                    <th>Cost (USD)</th>
                    <th>Cost (ZAR)</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <div style="font-size:2rem;">&#128203;</div>
                            <div class="mt-2">No service requests yet.</div>
                            <a asp-action="Create" class="btn btn-sm btn-dark mt-3">
                                + Create your first request
                            </a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sr in Model)
                    {
                        <tr>
                            <td class="ps-3 text-muted small">@sr.Id</td>
                            <td>
                                <a asp-controller="Contracts"
                                       asp-action="Details"
                                       asp-route-id="@sr.ContractId"
                                       class="text-decoration-none fw-semibold">
                                    #@sr.ContractId
                                </a>
                            </td>
                            <td class="small">@sr.Contract?.Client?.Name</td>
                            <td style="max-width:200px;">
                                <span class="text-truncate d-block" style="max-width:180px;"
                                      title="@sr.Description">
                                    @sr.Description
                                </span>
                            </td>
                            <td class="fw-semibold">$@sr.CostUSD.ToString("N2")</td>
                            <td class="fw-semibold text-success">R @sr.CostZAR.ToString("N2")</td>
                            <td>
                                @{
                                    var badgeClass = sr.Status switch
                                    {
                                        GLMS.Web.Models.RequestStatus.Pending => "bg-warning text-dark",
                                        GLMS.Web.Models.RequestStatus.InProgress => "bg-primary",
                                        GLMS.Web.Models.RequestStatus.Completed => "bg-success",
                                        GLMS.Web.Models.RequestStatus.Cancelled => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@sr.Status</span>
                            </td>
                            <td class="text-muted small">
                                @sr.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@sr.Id"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>