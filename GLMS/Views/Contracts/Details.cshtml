@model GLMS.Web.Models.Contract
@using GLMS.Web.Models
@{
    ViewData["Title"] = "Contract Details";
    var signedUpload = ViewBag.SignedUpload as ClientSignedContract;
}

<div class="mb-3">
    <a asp-action="Index" class="text-secondary text-decoration-none">
        &#8592; Back to Contracts
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <strong>Done!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">

        @* Contract info *@
        <div class="card mb-4">
            <div class="card-header bg-dark text-white
                d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    Contract #@Model.Id — @Model.Client?.Name
                </h5>
                <span class="badge badge-@Model.Status.ToString() fs-6">
                    @Model.Status
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <small class="text-muted d-block">Service Level</small>
                        <strong>@Model.ServiceLevel</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Start Date</small>
                        <strong>@Model.StartDate.ToShortDateString()</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">End Date</small>
                        <strong>@Model.EndDate.ToShortDateString()</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Client</small>
                        <strong>@Model.Client?.Name</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Region</small>
                        <strong>@Model.Client?.Region</strong>
                    </div>
                </div>
            </div>
        </div>

        @* ── STEP 1: Download contract ── *@
        <div class="card mb-4">
            <div class="card-header text-white"
                 style="background:#1a1a2e;">
                <h6 class="mb-0">
                    &#128196; Step 1 — Download Contract Document
                </h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                {
                    <div class="d-flex align-items-center
                        justify-content-between p-3 rounded"
                         style="background:#f0fdf4;
                        border:1px solid #bbf7d0;">
                        <div class="d-flex align-items-center gap-3">
                            <div style="font-size:2.5rem;">&#128196;</div>
                            <div>
                                <div class="fw-bold">
                                    Contract Agreement — GLMS-@($"{Model.Id:D5}")
                                </div>
                                <small class="text-muted">
                                    Download → Print → Sign → Upload below
                                </small>
                            </div>
                        </div>
                        <a asp-action="DownloadAgreement"
                               asp-route-id="@Model.Id"
                               class="btn btn-success px-4">
                            &#11123; Download PDF
                        </a>
                    </div>
                }
                else
                {
                    <div class="p-3 rounded"
                         style="background:#fff7ed;
                        border:1px solid #fed7aa;">
                        <strong class="text-warning">
                            &#9203; Not ready yet
                        </strong>
                        <p class="mb-0 mt-1 small text-muted">
                            Your contract is being prepared. You will be
                            notified once it is ready to download.
                        </p>
                    </div>
                }
            </div>
        </div>

        @* ── STEP 2: Upload signed contract (client only) ── *@
        @if (!User.IsInRole("Admin"))
        {
            <div class="card mb-4">
                <div class="card-header text-white"
                     style="background:#1a1a2e;">
                    <h6 class="mb-0">
                        &#11014; Step 2 — Upload Your Signed Contract
                    </h6>
                </div>
                <div class="card-body">

                    @if (signedUpload != null)
                    {
                        <div class="alert alert-success
                            d-flex justify-content-between
                            align-items-center mb-3">
                            <div>
                                <strong>
                                    &#10003; Signed contract received
                                </strong>
                                <div class="small text-muted">
                                    Uploaded:
                                    @signedUpload.UploadedAt
                                    .ToString("dd MMM yyyy HH:mm")
                                </div>
                            </div>
                            <span class="badge bg-success fs-6">
                                Submitted
                            </span>
                        </div>
                        <p class="text-muted small mb-3">
                            Need to replace it? Upload a new file below.
                        </p>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3">
                            <strong>&#9888; Action required</strong> —
                            Download the contract above, sign it, then
                            upload your signed copy here.
                        </div>
                    }

                    <form asp-action="UploadSignedContract"
                          method="post"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="contractId"
                               value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Select Your Signed PDF
                            </label>
                            <input type="file"
                                   name="signedFile"
                                   class="form-control"
                                   accept=".pdf"
                                   required />
                            <div class="form-text text-muted">
                                PDF only. Max 10MB.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark">
                            &#11014; Upload Signed Contract
                        </button>
                    </form>
                </div>
            </div>
        }

        @* ── Admin: View signed contract ── *@
        @if (User.IsInRole("Admin"))
        {
            <div class="card mb-4">
                <div class="card-header @(signedUpload != null ? "bg-success" : "bg-warning") text-white">
                    <h6 class="mb-0">
                        @if (signedUpload != null)
                        {
                            <span>&#10003; Signed Contract Received</span>
                        }
                        else
                        {
                            <span>&#9203; Awaiting Client Signature</span>
                        }
                    </h6>
                </div>
                <div class="card-body">
                    @if (signedUpload != null)
                    {
                        <div class="d-flex align-items-center
                            justify-content-between p-3 rounded"
                             style="background:#f0fdf4;
                            border:1px solid #bbf7d0;">
                            <div>
                                <div class="fw-semibold">
                                    Signed by client
                                </div>
                                <small class="text-muted">
                                    Uploaded:
                                    @signedUpload.UploadedAt
                                    .ToString("dd MMM yyyy HH:mm")
                                </small>
                            </div>
                            <a asp-action="DownloadSignedContract"
                                   asp-route-id="@signedUpload.Id"
                                   class="btn btn-success px-4">
                                &#11123; Download Signed Copy
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 small">
                            The client has not yet uploaded their
                            signed contract.
                        </p>
                    }
                </div>
            </div>

            @* Admin: Update status *@
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">&#9998; Update Contract Status</h6>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus"
                          method="post"
                          class="d-flex align-items-center gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="newStatus" class="form-select w-auto">
                            @foreach (ContractStatus s in
                                Enum.GetValues<ContractStatus>())
                            {
                                <option value="@s"
                                        selected="@(Model.Status == s)">
                                    @s
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-warning">
                            Update Status
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <strong>Status:</strong> @Model.Status —
                @if (Model.Status == ContractStatus.Active)
                {
                    <span>Active. You may raise service requests.</span>
                }
                else if (Model.Status == ContractStatus.Draft)
                {
                    <span>
                        Being prepared. You will be notified when active.
                    </span>
                }
                else if (Model.Status == ContractStatus.Expired)
                {
                    <span>This contract has expired.</span>
                }
                else
                {
                    <span>This contract is currently on hold.</span>
                }
            </div>
        }

    </div>

    @* Service requests *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-dark text-white
                d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Service Requests</h6>
                @if (Model.Status == ContractStatus.Active)
                {
                    <a asp-controller="ServiceRequests"
                           asp-action="Create"
                           asp-route-contractId="@Model.Id"
                           class="btn btn-sm btn-outline-light">
                        + New
                    </a>
                }
            </div>
            <div class="card-body p-0">
                @if (!Model.ServiceRequests.Any())
                {
                    <p class="text-muted p-3 mb-0 small">
                        No service requests yet.
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var sr in Model.ServiceRequests)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <span class="small fw-semibold">
                                        @sr.Description
                                    </span>
                                    <span class="badge bg-secondary">
                                        @sr.Status
                                    </span>
                                </div>
                                <small class="text-muted">
                                    R @sr.CostZAR.ToString("N2")
                                    ($ @sr.CostUSD.ToString("N2"))
                                </small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>