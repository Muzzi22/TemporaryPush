@model GLMS.Web.Models.Contract
@using System.IO
@{
    ViewData["Title"] = "Upload Contract Agreement";
    var fileName = (Model.SignedAgreementPath ?? "")
        .Split('/', '\\')
        .LastOrDefault() ?? "";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@Model.Id"
           class="text-secondary text-decoration-none">
        &#8592; Back to Contract #@Model.Id
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Upload Contract Agreement</h5>
                <small class="text-secondary">
                    Contract #@Model.Id — @Model.Client?.Name
                </small>
            </div>
            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @* Show current file if exists *@
                @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                {
                    <div class="alert alert-info d-flex justify-content-between
                        align-items-center mb-4">
                        <div>
                            <strong>Current file:</strong>
                            <span class="ms-2 small text-muted">
                                @fileName
                            </span>
                        </div>
                        <a asp-action="DownloadAgreement"
                               asp-route-id="@Model.Id"
                               class="btn btn-sm btn-outline-primary">
                            &#11123; Preview
                        </a>
                    </div>
                    <p class="text-warning small mb-3">
                        &#9888; Uploading a new file will replace
                        the current one.
                    </p>
                }
                else
                {
                    <div class="alert alert-warning mb-4">
                        <strong>&#9888; No agreement uploaded yet.</strong>
                        Clients cannot download anything until you
                        upload a PDF here.
                    </div>
                }

                <form asp-action="UploadAgreement"
                      asp-route-id="@Model.Id"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Select PDF File
                        </label>
                        <input type="file"
                               name="signedAgreement"
                               class="form-control"
                               accept=".pdf"
                               required />
                        <div class="form-text text-muted">
                            PDF files only. Max 10MB. This file will
                            be available for the client to download.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark px-4">
                            &#11014; Upload Agreement
                        </button>
                        <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>