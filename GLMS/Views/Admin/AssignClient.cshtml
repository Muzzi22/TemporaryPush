@model GLMS.Web.Models.ApplicationUser
@using GLMS.Web.Models
@{
    ViewData["Title"] = "Assign Client";
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
}

<div class="mb-3">
    <a href="/Admin/Users" class="text-secondary text-decoration-none">
        &#8592; Back to Users
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Assign Client to User</h5>
                <small class="text-secondary">
                    @Model.FullName — @Model.Email
                </small>
            </div>
            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-controller="Admin"
                      asp-action="AssignClient"
                      asp-route-userId="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Client Company
                        </label>
                        <select name="clientId" class="form-select">
                            <option value="">
                                -- No Client (Admin / Unassigned) --
                            </option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.Id"
                                        selected="@(Model.ClientId == client.Id)">
                                    @client.Name (@client.Region)
                                </option>
                            }
                        </select>
                        <div class="form-text text-muted">
                            Once assigned, this user will only see contracts
                            and notifications for this client.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark px-4">
                            Save Assignment
                        </button>
                        <a href="/Admin/Users"
                               class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>