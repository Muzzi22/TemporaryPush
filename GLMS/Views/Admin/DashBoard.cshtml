@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Admin Dashboard</h2>
        <small class="text-muted">System overview and controls</small>
    </div>
    <form asp-action="ExpireOldContracts" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-warning btn-sm"
                onclick="return confirm('Mark all past-due contracts as Expired?')">
            &#9889; Auto-Expire Old Contracts
        </button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card text-center p-3">
            <div class="text-muted small">Total Users</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalUsers</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center p-3">
            <div class="text-muted small">Total Clients</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalClients</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center p-3">
            <div class="text-muted small">Total Contracts</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalContracts</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center p-3" style="border: 1px solid #198754 !important;">
            <div class="text-muted small">Active</div>
            <div class="fs-3 fw-bold text-success">@ViewBag.ActiveContracts</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center p-3" style="border: 1px solid #dc3545 !important;">
            <div class="text-muted small">Expired</div>
            <div class="fs-3 fw-bold text-danger">@ViewBag.ExpiredContracts</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center p-3" style="border: 1px solid #ffc107 !important;">
            <div class="text-muted small">Pending Requests</div>
            <div class="fs-3 fw-bold text-warning">@ViewBag.PendingRequests</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <h6 class="fw-bold mb-2">&#128100; User Management</h6>
            <p class="text-muted small mb-3">Promote, demote, or remove user accounts.</p>
            <a asp-action="Users" class="btn btn-dark btn-sm">Manage Users</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h6 class="fw-bold mb-2">&#128196; Contracts</h6>
            <p class="text-muted small mb-3">View and manage all system contracts.</p>
            <a asp-controller="Contracts" asp-action="Index" class="btn btn-dark btn-sm">View Contracts</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h6 class="fw-bold mb-2">&#128203; Service Requests</h6>
            <p class="text-muted small mb-3">Monitor all service requests across contracts.</p>
            <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-dark btn-sm">View Requests</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h6 class="fw-bold mb-2">&#128196; Contract Status</h6>
            <p class="text-muted small mb-3">
                Update and manage contract statuses.
            </p>
            <a href="/Admin/Contracts" class="btn btn-dark btn-sm">
                Manage Contracts
            </a>
        </div>
    </div>
</div>