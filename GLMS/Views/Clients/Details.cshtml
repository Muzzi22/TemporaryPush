@model GLMS.Web.Models.Client
@{
    ViewData["Title"] = "Client Details";
}

<div class="mb-3">
    <a asp-action="Index" class="text-secondary text-decoration-none">&#8592; Back to Clients</a>
</div>

<div class="card mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.Name</h5>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-light">Edit</a>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <small class="text-muted">Contact</small>
                <p class="mb-0 fw-semibold">@Model.ContactDetails</p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Region</small>
                <p class="mb-0"><span class="badge bg-secondary">@Model.Region</span></p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Total Contracts</small>
                <p class="mb-0 fw-semibold">@Model.Contracts.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5>Contracts</h5>
    <a asp-controller="Contracts" asp-action="Create" class="btn btn-sm btn-dark">+ New Contract</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light">
                <tr><th>Service Level</th><th>Start</th><th>End</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Contracts)
                {
                    <tr>
                        <td>@c.ServiceLevel</td>
                        <td>@c.StartDate.ToShortDateString()</td>
                        <td>@c.EndDate.ToShortDateString()</td>
                        <td><span class="badge badge-@c.Status.ToString()">@c.Status</span></td>
                        <td><a asp-controller="Contracts" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>